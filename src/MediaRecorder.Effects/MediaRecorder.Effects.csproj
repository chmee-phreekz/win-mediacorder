<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows-Runtime-Komponente (C#/WinRT-Authoring) mit dem Kompressor als Media-Foundation-Audioeffekt.
    MediaCapture aktiviert Effekte per Klassenname über die Windows-Runtime; dafür muss der Effekt eine
    registrierte WinRT-Klasse sein. Die Registrierung erfolgt ohne Installation über app.manifest
    (activatableClass -> WinRT.Host.dll), WinRT.Host.dll und WinRT.Host.runtimeconfig.json
    werden von dieser Projekt-Referenz automatisch ins Ausgabeverzeichnis der App kopiert.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MediaRecorder.Effects</RootNamespace>
    <AssemblyName>MediaRecorder.Effects</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <!-- Ohne Angabe würde AnyCPU gebaut und das x86-WinRT.Host.dll kopiert. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <CsWinRTComponent>true</CsWinRTComponent>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaRecorder.Core\MediaRecorder.Core.csproj" />
  </ItemGroup>
</Project>
