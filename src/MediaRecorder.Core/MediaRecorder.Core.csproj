<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI-freie Logik: Encoding-Einstellungen, Timeline-Modell, Geometrie.
       Bewusst plattformneutral (net8.0), damit sie ohne Windows testbar ist. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MediaRecorder.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
