<Application
    x:Class="MediaRecorder.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Farben der Timeline-Spuren (V1 = Hauptspur, V2 = Overlay-Spur). -->
            <Color x:Key="TrackV1Color">#FF2F6FDE</Color>
            <Color x:Key="TrackV2Color">#FF8B5CF6</Color>
            <Color x:Key="PlayheadColor">#FFFF4D4F</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
