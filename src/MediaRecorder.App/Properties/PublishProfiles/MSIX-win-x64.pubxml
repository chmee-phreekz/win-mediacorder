<?xml version="1.0" encoding="utf-8"?>
<!--
  Veröffentlichungsprofil: Sideload-MSIX für x64, self-contained
  (.NET- und Windows-App-SDK-Runtime sind im Paket, auf dem Zielrechner muss nichts installiert sein).

  Ein Klick: Build-Msix.cmd in der Repo-Wurzel doppelklicken (ruft tools\Build-Msix.ps1 auf, nutzt MSBuild von Visual Studio).
  Kommandozeile:
    msbuild src\MediaRecorder.App\MediaRecorder.App.csproj /restore /p:Configuration=Release /p:Platform=x64 /p:PublishProfile=MSIX-win-x64

  Ergebnis: AppPackages\MediaRecorder.App_<Version>_x64_Test\ im Repo-Ordner (.msix und .cer).
  Signatur: certs\MediaRecorder.pfx, erzeugt mit tools\New-SigningCertificate.ps1 (siehe docs\Veroeffentlichen.md).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- MSIX statt Ordner-Veröffentlichung -->
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\..\..\AppPackages\</AppxPackageDir>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>

    <!-- Signatur mit dem Entwicklerzertifikat (Publisher muss zu Package.appxmanifest passen: CN=MediaRecorder Dev). -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>$(MSBuildThisFileDirectory)..\..\..\..\certs\MediaRecorder.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword>MediaRecorder</PackageCertificatePassword>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
  </PropertyGroup>
</Project>
