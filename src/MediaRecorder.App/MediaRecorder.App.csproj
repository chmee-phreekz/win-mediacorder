<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MediaRecorder.App</RootNamespace>
    <AssemblyName>MediaRecorder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!--
      MSIX-Paket (Single-Project-MSIX): nötig, damit Media Foundation den Kompressor-Effekt aktivieren kann
      (Registrierung in Package.appxmanifest). F5 installiert und startet das Paket; Windows-Entwicklermodus muss an sein.
    -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Für den direkten Zugriff auf Audiopuffer (VU-Meter, IMemoryBufferByteAccess). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaRecorder.Core\MediaRecorder.Core.csproj" />
    <!-- Kompressor-Audioeffekt (WinRT-Komponente). Gleiche Plattform wie die App, damit das passende WinRT.Host.dll kopiert wird. -->
    <ProjectReference Include="..\MediaRecorder.Effects\MediaRecorder.Effects.csproj" SetPlatform="Platform=$(Platform)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
