<Page
    x:Class="MediaRecorder.App.Views.RecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MediaRecorder.App.Converters"
    xmlns:controls="using:MediaRecorder.App.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <conv:NotNullToBoolConverter x:Key="RecordNotNullToBool" />
        <conv:NullToVisibleConverter x:Key="RecordNullToVisible" />
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,16" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Meldungen -->
        <StackPanel Grid.ColumnSpan="3" Spacing="8">
            <InfoBar Severity="Error" Title="Fehler"
                     IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource RecordNotNullToBool}}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     CloseButtonClick="ErrorBar_Closed" />
            <InfoBar Severity="Success" Title="Aufnahme beendet"
                     IsOpen="{x:Bind ViewModel.InfoMessage, Mode=OneWay, Converter={StaticResource RecordNotNullToBool}}"
                     Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                     CloseButtonClick="InfoBar_Closed">
                <InfoBar.ActionButton>
                    <Button Content="Ordner öffnen" Command="{x:Bind ViewModel.OpenOutputFolderCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Vorschau: immer im richtigen Seitenverhältnis, größtmöglich (Stretch=Uniform) -->
        <Border Grid.Row="1" CornerRadius="8" Background="Black"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <MediaPlayerElement x:Name="Preview"
                                    Stretch="Uniform"
                                    AreTransportControlsEnabled="False"
                                    AutoPlay="True" />
                <TextBlock Text="Keine Vorschau"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.PreviewPlayer, Mode=OneWay, Converter={StaticResource RecordNullToVisible}}" />

                <!-- REC-Anzeige -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                        Padding="10,4" CornerRadius="4" Background="#B0000000"
                        Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#FFE5484D" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="16" Foreground="White" />
                        <TextBlock Text="PAUSE" Foreground="#FFFFC53D" FontWeight="SemiBold"
                                   Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="48" Height="48" />
            </Grid>
        </Border>

        <!-- Einstellungen -->
        <!-- VU-Meter rechts neben dem Videobild -->
        <Border Grid.Row="1" Grid.Column="1" Width="76" Padding="8,10"
                Style="{StaticResource Card}"
                Visibility="{x:Bind ViewModel.IsAudioMeterVisible, Mode=OneWay}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="dBFS" HorizontalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <controls:VuMeter x:Name="Meter" Grid.Row="1" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <!-- StackPanel hat in WinUI 3 kein IsEnabled: ContentControl sperrt Geräte- und Codec-Einstellungen während der Aufnahme.
                 Der Kompressor bleibt bedienbar, auch während der Aufnahme. -->
            <StackPanel Spacing="12">
            <ContentControl IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                            IsTabStop="False">
            <StackPanel Spacing="12">

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Eingänge" Style="{StaticResource SectionHeader}" />
                            <Button HorizontalAlignment="Right" Padding="6" ToolTipService.ToolTip="Geräte neu suchen"
                                    Command="{x:Bind ViewModel.RefreshDevicesCommand}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ComboBox Header="Video" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.VideoDevices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedVideoDevice, Mode=TwoWay}" />
                        <ComboBox Header="Format" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.VideoFormats}"
                                  SelectedItem="{x:Bind ViewModel.SelectedVideoFormat, Mode=TwoWay}" />
                        <ComboBox Header="Audio" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.AudioDevices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAudioDevice, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

            </StackPanel>
            </ContentControl>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Kompressor" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0" />
                            <ToggleSwitch HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent=""
                                          IsOn="{x:Bind ViewModel.CompressorEnabled, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Spacing="10" Opacity="{x:Bind CompressorOpacity(ViewModel.CompressorEnabled), Mode=OneWay}">
                            <Grid>
                                <TextBlock Text="Threshold" />
                                <TextBlock HorizontalAlignment="Right" FontFamily="Consolas" Text="{x:Bind ViewModel.ThresholdText, Mode=OneWay}" />
                            </Grid>
                            <Slider Minimum="{x:Bind ViewModel.CompressorMinThreshold}" Maximum="{x:Bind ViewModel.CompressorMaxThreshold}"
                                    StepFrequency="0.5" SmallChange="0.5" LargeChange="3"
                                    Value="{x:Bind ViewModel.CompressorThresholdDb, Mode=TwoWay}" />
                            <Grid>
                                <TextBlock Text="Ratio" />
                                <TextBlock HorizontalAlignment="Right" FontFamily="Consolas" Text="{x:Bind ViewModel.RatioText, Mode=OneWay}" />
                            </Grid>
                            <Slider Minimum="{x:Bind ViewModel.CompressorMinRatio}" Maximum="{x:Bind ViewModel.CompressorMaxRatio}"
                                    StepFrequency="0.1" SmallChange="0.1" LargeChange="1"
                                    Value="{x:Bind ViewModel.CompressorRatio, Mode=TwoWay}" />
                            <Grid>
                                <TextBlock Text="Gain" />
                                <TextBlock HorizontalAlignment="Right" FontFamily="Consolas" Text="{x:Bind ViewModel.GainText, Mode=OneWay}" />
                            </Grid>
                            <Slider Minimum="{x:Bind ViewModel.CompressorMinGain}" Maximum="{x:Bind ViewModel.CompressorMaxGain}"
                                    StepFrequency="0.5" SmallChange="0.5" LargeChange="3"
                                    Value="{x:Bind ViewModel.CompressorGainDb, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.GainReductionText, Mode=OneWay}" FontFamily="Consolas"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <InfoBar Severity="Warning" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.CompressorWarning, Mode=OneWay, Converter={StaticResource RecordNotNullToBool}}"
                                 Message="{x:Bind ViewModel.CompressorWarning, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Content="Jetzt registrieren (Adminrechte)"
                                        Visibility="{x:Bind ViewModel.CanRegisterCompressor, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.RegisterCompressorCommand}" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Border>

            <ContentControl IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                            IsTabStop="False">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Codec" Style="{StaticResource SectionHeader}" />
                        <ComboBox Header="Container" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Containers}"
                                  SelectedItem="{x:Bind ViewModel.ContainerItem, Mode=TwoWay}" />
                        <ComboBox Header="Videocodec" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.VideoCodecs}"
                                  SelectedItem="{x:Bind ViewModel.VideoCodecItem, Mode=TwoWay}" />
                        <NumberBox Header="Videobitrate (Mbit/s)"
                                   Value="{x:Bind ViewModel.VideoBitrateMbps, Mode=TwoWay}"
                                   Minimum="0.5" Maximum="400" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Inline" />
                        <ComboBox Header="Audiocodec" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.AudioCodecs}"
                                  SelectedItem="{x:Bind ViewModel.AudioCodecItem, Mode=TwoWay}" />
                        <ComboBox Header="Audiobitrate (kbit/s)" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.AudioBitrates}"
                                  SelectedItem="{x:Bind ViewModel.AudioBitrateItem, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsAudioBitrateEditable, Mode=OneWay}" />
                        <InfoBar Severity="Warning" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.CodecWarning, Mode=OneWay, Converter={StaticResource RecordNotNullToBool}}"
                                 Message="{x:Bind ViewModel.CodecWarning, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Ziel" Style="{StaticResource SectionHeader}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Ordner" IsReadOnly="True" Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Wählen…" Click="PickFolder_Click" />
                        </Grid>
                        <TextBox Header="Dateiname" Text="{x:Bind ViewModel.FileNamePattern, Mode=TwoWay}"
                                 PlaceholderText="Aufnahme_{date}_{time}" />
                        <TextBlock Text="{x:Bind ViewModel.FreeSpaceText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Transportleiste -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RecordButton" MinWidth="140" Height="40"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleRecordCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Height="40" Command="{x:Bind ViewModel.PauseCommand}"
                        ToolTipService.ToolTip="Pause / Fortsetzen">
                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" FontFamily="Consolas" FontSize="20" />
                    <TextBlock Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>
