<Page
    x:Class="MediaRecorder.App.Views.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MediaRecorder.App.ViewModels"
    xmlns:controls="using:MediaRecorder.App.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <Style x:Key="EditCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="40" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Schnitt" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="FormatBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                      ToolTipService.ToolTip="Projektformat (Seitenverhältnis und Bildrate von Vorschau und Export)"
                      ItemsSource="{x:Bind ViewModel.Formats}"
                      SelectionChanged="FormatBox_SelectionChanged" />
            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.UndoCommand}"
                    ToolTipService.ToolTip="Rückgängig (Strg+Z)">
                <FontIcon Glyph="&#xE7A7;" FontSize="16" />
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.RedoCommand}"
                    ToolTipService.ToolTip="Wiederholen (Strg+Y)">
                <FontIcon Glyph="&#xE7A6;" FontSize="16" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="Export_Click"
                    IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                    ToolTipService.ToolTip="Exportieren (Strg+E)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEDE1;" FontSize="16" />
                    <TextBlock Text="Exportieren" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Meldungen -->
        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar Severity="Error" Title="Fehler"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Closed="ErrorBar_Closed" />
            <InfoBar Severity="Informational"
                     IsOpen="{x:Bind ViewModel.HasInfo, Mode=OneWay}"
                     Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                     Closed="InfoBar_Closed" />
            <InfoBar Severity="Informational" Title="Export läuft" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.IsExporting, Mode=OneWay}">
                <InfoBar.Content>
                    <Grid ColumnSpacing="12" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Abbrechen" Command="{x:Bind ViewModel.CancelExportCommand}" />
                    </Grid>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <!-- Medienpool + Vorschau -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource EditCard}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Medien" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="Import_Click" ToolTipService.ToolTip="Mediendateien importieren (Strg+I)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock Text="Importieren" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView x:Name="AssetList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Assets}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              DragItemsStarting="AssetList_DragItemsStarting"
                              SelectionChanged="AssetList_SelectionChanged"
                              DoubleTapped="AssetList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaAssetItem">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Aus Medien entfernen" Click="RemoveAsset_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <!-- Vorschaubild immer seitenrichtig (Uniform) im festen Rahmen -->
                                    <Border Width="72" Height="44" CornerRadius="4" Background="Black">
                                        <Grid>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.6" />
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Info}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind IsEmpty(ViewModel.Assets.Count), Mode=OneWay}"
                               Text="Dateien hierher ziehen oder „Importieren“ wählen. Video, Audio und Bilder werden unterstützt." />

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AddToMainTrackCommand}"
                                ToolTipService.ToolTip="Ans Ende von V1 anhängen (Doppelklick)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Auf V1" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AddToOverlayTrackCommand}"
                                ToolTipService.ToolTip="Am Abspielkopf auf V2 (Overlay) legen">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Auf V2" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource EditCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Vorschau: Uniform = korrektes Seitenverhältnis, größtmöglich in der verfügbaren Fläche -->
                    <Grid x:Name="PreviewHost" Background="#FF0B0B0C" CornerRadius="8,8,0,0" SizeChanged="PreviewHost_SizeChanged">
                        <Border x:Name="PreviewFrame" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <MediaPlayerElement x:Name="Preview" Stretch="Uniform" AreTransportControlsEnabled="False" />
                        </Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.ShowEmptyHint, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8B2;" FontSize="40" Opacity="0.4" />
                            <TextBlock Text="Clips auf die Timeline ziehen, um die Vorschau zu sehen" Opacity="0.6" />
                        </StackPanel>
                    </Grid>

                    <!-- Transport -->
                    <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="15">
                            <Run Text="{x:Bind ViewModel.PlayheadText, Mode=OneWay}" />
                            <Run Text=" / " Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Run Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.GoToStartCommand}" ToolTipService.ToolTip="Zum Anfang (Pos1)">
                                <FontIcon Glyph="&#xE892;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.StepBackCommand}" ToolTipService.ToolTip="Ein Bild zurück (←)">
                                <FontIcon Glyph="&#xE76B;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="14,6" Command="{x:Bind ViewModel.PlayPauseCommand}" ToolTipService.ToolTip="Wiedergabe/Pause (Leertaste)">
                                <FontIcon Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.StepForwardCommand}" ToolTipService.ToolTip="Ein Bild vor (→)">
                                <FontIcon Glyph="&#xE76C;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.GoToEndCommand}" ToolTipService.ToolTip="Zum Ende (Ende)">
                                <FontIcon Glyph="&#xE893;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Schnittwerkzeuge -->
        <Grid Grid.Row="3" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.SplitCommand}" ToolTipService.ToolTip="Am Abspielkopf teilen (S). Ohne Auswahl: alle Spuren">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C6;" FontSize="14" /><TextBlock Text="Teilen" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.DeleteClipCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        ToolTipService.ToolTip="Clip entfernen, Lücke bleibt (Entf)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Entfernen" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.RippleDeleteClipCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        ToolTipService.ToolTip="Clip entfernen und Lücke schließen (Umschalt+Entf)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8BB;" FontSize="14" /><TextBlock Text="Entfernen + nachrücken" /></StackPanel>
                </Button>
                <ToggleButton Padding="10,6" MinWidth="40" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.IsSelectedClipMuted, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleMuteCommand}"
                              ToolTipService.ToolTip="Ton des Clips stumm schalten (M)">
                    <FontIcon Glyph="&#xE74F;" FontSize="14" />
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0">
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.SetInPointCommand}" ToolTipService.ToolTip="In-Punkt setzen (I)">
                    <TextBlock Text="[ In" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.SetOutPointCommand}" ToolTipService.ToolTip="Out-Punkt setzen (O)">
                    <TextBlock Text="Out ]" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.CutRangeCommand}" IsEnabled="{x:Bind ViewModel.HasRange, Mode=OneWay}"
                        ToolTipService.ToolTip="Bereich auf beiden Spuren ausschneiden, Lücke schließen (X)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C6;" FontSize="14" /><TextBlock Text="Bereich ausschneiden" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.ClearRangeCommand}" ToolTipService.ToolTip="Bereich aufheben">
                    <FontIcon Glyph="&#xE894;" FontSize="12" />
                </Button>
                <TextBlock Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE71F;" FontSize="14" Opacity="0.7" />
                <Slider x:Name="ZoomSlider" Width="160" Minimum="0" Maximum="100" Value="45" StepFrequency="1"
                        VerticalAlignment="Center" ToolTipService.ToolTip="Zoom (Strg+Mausrad)" ValueChanged="ZoomSlider_ValueChanged" />
                <FontIcon Glyph="&#xE8A3;" FontSize="14" Opacity="0.7" />
                <Button Style="{StaticResource ToolButton}" Click="ZoomFit_Click" ToolTipService.ToolTip="Ganze Timeline zeigen">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Timeline -->
        <Border Grid.Row="4" Style="{StaticResource EditCard}" Padding="8">
            <controls:TimelineControl x:Name="TimelineView" />
        </Border>
    </Grid>
</Page>
